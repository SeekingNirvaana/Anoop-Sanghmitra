{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "anoop-sanghmitra-invite",
  "main": ".cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
